# Copy this file to .env and fill in what you need. Everything is optional.

# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Real email (optional). Without these, emails go to the in-app Email outbox.
# Gmail: turn on 2-Step Verification, create an App Password, paste it below.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
